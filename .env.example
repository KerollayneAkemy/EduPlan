# Backend only. Never put secrets in frontend/VITE_* variables or commit .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=example-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-on-server-only
GEMINI_API_KEY=replace-on-server-only
GEMINI_MODEL=gemini-3.8-flash
MAX_UPLOAD_MB=15
DAILY_GENERATION_LIMIT=20
MINUTE_GENERATION_LIMIT=3
ALLOWED_ORIGINS=["http://localhost:5173"]
